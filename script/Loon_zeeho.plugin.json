{
  "name": "极核 ZEEHO 签到面板",
  "desc": "多账号实时数据面板 + 网页配置(appid/sign/token) + 自动捕获appId/appSecret，访问 http://zeeho.box",
  "homepage": "https://github.com/mlink798/ZEEHO",
  "author": "@lucky",
  "icon": "https://raw.githubusercontent.com/mlink798/ZEEHO/main/icon.png",
  "hosts": [
    "tapi.zeehoev.com",
    "h5.zeehoev.com",
    "zeeho.box"
  ],
  "rules": [],
  "script-providers": [],
  "scripts": [
    {
      "name": "极核面板",
      "type": "request",
      "pattern": "^http://zeeho\\.box",
      "script-url": "https://raw.githubusercontent.com/mlink798/ZEEHO/refs/heads/main/script/zeeho_box_enhanced.js",
      "requires-body": true,
      "timeout": 30
    },
    {
      "name": "极核签到",
      "type": "cron",
      "cron": "0 7 * * *",
      "script-url": "https://raw.githubusercontent.com/mlink798/ZEEHO/refs/heads/main/script/zeeho.js",
      "timeout": 120
    },
    {
      "name": "极核捕获",
      "type": "request",
      "pattern": "^https?://.*zeehoev\\.com/.*",
      "script-url": "https://raw.githubusercontent.com/mlink798/ZEEHO/refs/heads/main/script/appidappSecret.js",
      "requires-body": false,
      "timeout": 10
    }
  ]
}