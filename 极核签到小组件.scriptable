async function fetchSupplementPrize({ supplementDate, token }) {
  const url = "https://h5.zeehoev.com/cfmotoservermine/signin/supplementPrize";
  const params = { supplementDate };
  const signHeaders = getSign('h5', params);
  const fullUrl = `${url}?${toQuery(params)}`;
  
  const req = new Request(fullUrl);
  req.method = "GET";
  req.timeoutInterval = 20;
  
  const cleanToken = String(token).replace(/^[bB]earer\s+/i, "").trim();
  req.headers = {
    ...signHeaders,
    "Authorization": `Bearer ${cleanToken}`
  };
  
  try {
    const text = await req.loadString();
    const status = req.response?.statusCode || -1;
    if (status === 401 || status === 403) {
      throw new Error("TOKEN_EXPIRED");
    }
    try {
      return text ? JSON.parse(text) : {};
    } catch {
      return {};
    }
  } catch (e) {
    if (String(e?.message || "") === "TOKEN_EXPIRED") {
      throw new Error("TOKEN_EXPIRED");
    }
    throw e;
  }
}

